{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::documents-bucket",
        "arn:aws:s3:::documents-bucket/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/Service": "ECS"
        }
      }
    }
  ]
}